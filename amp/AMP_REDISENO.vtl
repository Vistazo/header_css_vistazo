          #set ($soloFecha = "${lbDia} ${lbMesTxt} ${lbAnio}")
          #set ($soloHora  = $indexFormatSoloHora.format($dResultado))

          #set ($temp = $itm.put("FECHA_POST", $soloFecha))
          #set ($temp = $itm.put("HORA_POST",  $soloHora))
          #set ($temp = $itm.put("DATE_POST",  $dResultado))
          #set ($temp = $reversedList.add(0, $itm))
        #end

        ##foreach($post in $sortTool.sort($reversedList, 'DATE_POST:desc'))
              #foreach($post in $sortTool.sort($reversedList, 'DATE_POST:desc'))


          #set ($soloFecha = $post.FECHA_POST)
          #set ($soloHora  = $post.HORA_POST)
          #set ($PostDate= $post.LBP_Date)
          #set ($PostText= $post.LBP_Text)
          #set ($PostCita= $post.LBP_Cita)
          #set ($PostBullet= $post.LBP_Bullet)

          #set ($PostchildrenTags = $articleToolbox.getChildrenTags($post))

          <div class="r_item_post p_$velocityCount">
            <div class="r_item_line">
                      <div class="r_point_post"></div>
                      <div class="r_vertical-line"></div> <!-- Línea vertical entre los puntos -->
                  </div>
            <div class="r_item_content">
              <div class="r_date_post" data-date="$!PostDate.data">
                <div class="r_hora_post">$!soloHora</div>
          <div class="r_fecha_post">$!soloFecha</div>
              
              </div>
              <div class="r_content_post">
                <div class="r_headline_post">$!post.data</div>
                <div class="r_text_post">$!PostText.data</div>
              #foreach ($el in $PostchildrenTags)
                #if($el.name == "LBP_HTML")
                  ## El HTML del editor (tuits, embeds) invalida AMP tal cual:
                  ## mismo saneado que se aplica a HTML_Text mas arriba.
                  #set($lbpHtml = $!el.data)
                  #set($lbpHtml = $lbpHtml.replaceAll('!important', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('(?is)<script[^>]*>.*?</script>', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('(?is)<script[^>]*>', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('style=".*?"', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('loading="lazy"', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('(?i) xml:lang="[^"]*"', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('(?i) lang="[^"]*"', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('<picture', '<div'))
                  #set($lbpHtml = $lbpHtml.replaceAll('</picture>', '</div>'))
                  #set($lbpHtml = $lbpHtml.replaceAll('<source(.*?)>', ''))
                  #set($lbpHtml = $lbpHtml.replaceAll('<video', '<amp-video layout="responsive" width="640" height="360"'))
                  #set($lbpHtml = $lbpHtml.replaceAll('</video>', '</amp-video>'))
                  #set($lbpHtml = $lbpHtml.replaceAll('<iframe', '<amp-iframe'))
                  #set($lbpHtml = $lbpHtml.replaceAll('</iframe>', '</amp-iframe>'))
                  #if($lbpHtml.contains('youtube.com') || $lbpHtml.contains('youtu.be'))
                    #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe[^>]*)( allow="[^"]*")([^>]*>)', '$1$3'))
                    #set($lbpHtml = $lbpHtml.replaceAll('[?]si=[^"]*"', '"'))
                    #set($lbpHtml = $lbpHtml.replaceAll('<amp-iframe', '<amp-youtube layout="responsive"'))
                    #set($lbpHtml = $lbpHtml.replaceAll('src="https://www.youtube.com/embed/', 'data-videoid="'))
                    #set($lbpHtml = $lbpHtml.replaceAll('</amp-iframe>', '</amp-youtube>'))
                  #end
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-youtube[^>]*?) allowfullscreen(?:="[^"]*")?', '$1'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-youtube[^>]*?) allow="[^"]*"', '$1'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-youtube[^>]*?) frameborder="[^"]*"', '$1'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe[^>]*?) (?:webkit)?allowfullscreen(?:="[^"]*")?', '$1'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe[^>]*?) frameborder="[^"]*"', '$1'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe(?![^>]*layout=)[^>]*)(>)', '$1 layout="responsive"$2'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe(?![^>]*width=)[^>]*)(>)', '$1 width="640"$2'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe(?![^>]*height=)[^>]*)(>)', '$1 height="410"$2'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-iframe(?![^>]*sandbox=)[^>]*)(>)', '$1 sandbox="allow-scripts allow-same-origin"$2'))
                  #set($lbpHtml = $lbpHtml.replaceAll('<img(.*?)>', '<amp-img$1></amp-img>'))
                  #set($lbpHtml = $lbpHtml.replaceAll('(<amp-img(?![^>]*layout=)(?![^>]*width=)(?![^>]*height=))', '$1 layout="responsive" width="640" height="360"'))
                  <div class="r_html_post">$!lbpHtml</div>
                #end

                #if($el.name == "LBP_Image")
                  <div class="r_image_post">
                      $!articleToolbox.getImageTag("$el.name","$el.Milenium.data","crop_650_350_PodHea","","","","false","$!post.data","$!post.data","100%")
                  </div>
                #end
                #if($el.name == "LBP_Multimedia")
                  <div class="r_multimedia_post">
                  #if($el.Extension.data && $el.Extension.data == "mp3")
                    <amp-audio width="auto" height="50" src="$!el.Document.data"></amp-audio>
                  #elseif ($el.Extension.data && $el.Extension.data == "mp4")
                    <amp-video controls layout="responsive" width="640" height="360" poster="$!el.Preview.data">
                      <source src="$!el.Document.data" type="video/mp4" />
                    </amp-video>
                  #end
                  </div>
                #end
                #if($el.name == "LBP_Youtube")
                  <div class="r_youtube_post">
                      $el.data
                    ##<iframe allowfullscreen="" frameborder="0" height="360"  width="640" src="//www.youtube.com/embed/?wmode=transparent&controls=2&showinfo=0&theme=light"></iframe>
                  </div>
                #end
                #if($el.name == "LBP_Cita")
                  <div class="r_cita_post">
                    <span></span> ${el.data}
                  </div>
                #end
                #if($el.name == "LBP_Bullet")
                  <div class="r_bullet_post">
                    #foreach ($bullet in $el.getSiblings())
                      <span>${bullet.data}</span>
                    #end
                  </div>
                #end
              #end
                <hr class="r_linea_hr"/>
                <div class="r_social-icons">
                  <a href="https://facebook.com/sharer/sharer.php?u=#siteUrl()#printAcCanonicalUrl_v1()" target="_blank">
                    <amp-img src="https://codigomarret.online/upload/img/facebook.svg" alt="Facebook" width="24" height="24"></amp-img>
                  </a>
                  <a href="https://api.whatsapp.com/send?text=#siteUrl()#printAcCanonicalUrl_v1()" target="_blank">
                    <amp-img src="https://codigomarret.online/upload/img/icons8-whatsapp.svg" alt="WhatsApp" width="24" height="24"></amp-img>
                  </a>
                  <a href="https://twitter.com/intent/tweet?text=#siteUrl()#printAcCanonicalUrl_v1()" target="_blank">
                    <amp-img src="https://codigomarret.online/upload/img/icons8-twitterx.svg" alt="Twitter" width="24" height="24"></amp-img>
                        </a>
                    </div>
              </div>
            </div>
          </div>

        #end
      </div>


      </article>

      <amp-analytics type="taboola" id="taboola">
        <script type="application/json">{"vars":{"aid":"adops-vistazo"}}</script>
      </amp-analytics>

        <amp-analytics type="gtag" data-credentials="include">
          <script type="application/json">
          {
            "vars": {
              "gtag_id": "G-Z9ZDG6FEG4",
              "config": {
                "G-Z9ZDG6FEG4": { "groups": "default" }
              }
            },
            "triggers": {
              "scroll25": {
                "on": "scroll",
                "scrollSpec": { "verticalBoundaries": [25] },
                "request": "event",
                "vars": {
                  "event_name": "article_scroll",
                  "percent_scrolled": "25",
                  "article_title": "$!escapeTool.html($titulo)",
                  "article_section": "$!escapeTool.html($section)"
                }
              },
              "scroll50": {
                "on": "scroll",
                "scrollSpec": { "verticalBoundaries": [50] },
                "request": "event",
                "vars": {
                  "event_name": "article_scroll",
                  "percent_scrolled": "50",
                  "article_title": "$!escapeTool.html($titulo)",
                  "article_section": "$!escapeTool.html($section)"
                }
              },
              "scroll90": {
                "on": "scroll",
                "scrollSpec": { "verticalBoundaries": [90] },
                "request": "event",
                "vars": {
                  "event_name": "article_scroll",
                  "percent_scrolled": "90",
                  "article_title": "$!escapeTool.html($titulo)",
                  "article_section": "$!escapeTool.html($section)"
                }
              },
              "relatedClick": {
                "on": "click",
                "selector": ".inline-related a, .amp-related a",
                "request": "event",
                "vars": {
                  "event_name": "related_article_click",
                  "related_position": "${relatedPosition}",
                  "related_title": "${relatedTitle}",
                  "article_title": "$!escapeTool.html($titulo)",
                  "article_section": "$!escapeTool.html($section)"
                }
              }
            }
          }
          </script>
        </amp-analytics>


    </main>
  </body>
</html>