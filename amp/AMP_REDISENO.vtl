<!DOCTYPE html>
<html amp lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>$!titulo</title>
    <meta property="og:title" content="$!escapeTool.html($!articleToolbox.getTag(null,'Headline').data)">
    <meta property="og:description" content="$!escapeTool.html($ogdescription)">
    <meta property="og:type" content="Article">
    <meta property="og:image" content="$ogimage">
    <meta property="og:url" content="$canonicalUrl">
    <meta property="og:site_name" content="https://www.vistazo.com/">
    <link rel="shortcut icon" href="base-portlet/webrsrc/ctxvar/3919f906-cc6b-4768-ab0e-8123df38601c.svg">
    <link rel="canonical" href="$canonicalUrl" />

    <style amp-boilerplate>
      body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}
      @-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}
      @-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}
      @-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}
      @-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}
      @keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}
    </style>
    <noscript><style amp-boilerplate>body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}</style></noscript>

    <link href="https://fonts.googleapis.com/css2?family=Crete+Round&display=swap" rel="stylesheet">

    <!-- ====== ESTILOS ====== -->
    <style amp-custom>
      :root{--vistazo-red:#d71920;--vistazo-black:#111;--vistazo-gray:#666;--vistazo-border:#e5e5e5;--vistazo-background:#f5f5f5}
      *{box-sizing:border-box}
      html{font-size:16px}
      body{margin:0;background:var(--vistazo-background);color:var(--vistazo-black);font-family:Arial,Helvetica,sans-serif}
      .amp-content{width:100%;max-width:100%;font-family:Arial,Helvetica,sans-serif}
      .simp-head{position:sticky;top:0;z-index:100;height:64px;margin:0;padding:0 16px;background:#fff;border-bottom:1px solid var(--vistazo-border);box-shadow:0 2px 10px rgba(0,0,0,.04)}
      .simp-head::after{position:absolute;right:0;bottom:-1px;left:0;height:3px;background:var(--vistazo-red);content:""}
      .title{display:flex;height:100%;align-items:center;justify-content:center}
      .logo_cab{display:block;width:170px;height:42px;margin:0;background:url('/base-portlet/webrsrc/renderer/4e1a9f06734d0ca437ae1e716395f9f0.png') no-repeat center/contain}
      .hamburger_wrapper{position:absolute;top:18px;left:16px;padding:0;z-index:110}
      #hamburger{position:relative;width:28px;height:24px;cursor:pointer}
      #hamburger span{position:absolute;left:0;width:100%;height:3px;border-radius:0;background:#111;transition:transform .25s ease,opacity .25s ease,top .25s ease}
      #hamburger span:nth-child(1){top:1px}
      #hamburger span:nth-child(2){top:10px}
      #hamburger span:nth-child(3){top:19px}
      #hamburger.close span:nth-child(1){top:10px;transform:rotate(45deg)}
      #hamburger.close span:nth-child(2){opacity:0}
      #hamburger.close span:nth-child(3){top:10px;transform:rotate(-45deg)}
      #nav-menu{position:fixed;top:64px;left:0;width:min(77vw,280px);height:calc(100vh - 64px);overflow-y:auto;background:#fff;border-right:1px solid #e5e5e5;box-shadow:8px 0 24px rgba(0,0,0,.18);opacity:0;transform:translateX(-105%);transition:transform .3s ease,opacity .2s ease;z-index:105}
      #nav-menu.now-active{opacity:1;transform:translateX(0)}
      .nav-inner{padding:12px 0 18px}
      .nav-accent{width:30px;height:4px;margin:0 0 20px 16px;background:var(--vistazo-red)}
      .nav-list{margin:0;padding:0;list-style:none}
      .nav-list>li{margin:0}
      .nav-link{display:block;padding:11px 19px;color:#222;font-size:15px;font-weight:400;line-height:1.35;text-decoration:none}
      .nav-link:hover,.nav-link:focus{color:var(--vistazo-red)}
      .nav-accordion{margin:0;padding:0}
      .nav-accordion section{border:0}
      .nav-accordion section>header{display:flex;min-height:43px;margin:0;padding:0;background:#fff;border:0;align-items:stretch;font-family:Arial,Helvetica,sans-serif;font-weight:400}
      .nav-accordion section>header:focus{outline:0}
      .nav-parent-link{display:flex;flex:1;padding:11px 19px;align-items:center;color:#222;font-size:15px;line-height:1.35;text-decoration:none}
      .nav-arrow{position:relative;display:flex;width:49px;border-left:1px solid #e7e7e7;align-items:center;justify-content:center}
      .nav-arrow::before{width:7px;height:7px;border-right:2px solid #999;border-bottom:2px solid #999;content:"";transform:rotate(45deg) translate(-1px,-1px);transition:transform .2s ease}
      .nav-accordion section[expanded]>header{background:#f4f4f4;border-left:3px solid var(--vistazo-red)}
      .nav-accordion section[expanded]>header .nav-parent-link{padding-left:16px;color:var(--vistazo-red)}
      .nav-accordion section[expanded]>header .nav-arrow::before{border-color:#e76b6b;transform:rotate(225deg) translate(-1px,-1px)}
      .nav-submenu{padding:3px 0 7px;background:#fff}
      .nav-submenu a{display:block;padding:10px 20px 10px 35px;color:#666;font-size:14px;line-height:1.35;text-decoration:none}
      .nav-submenu a:hover,.nav-submenu a:focus{color:var(--vistazo-red)}
      .nav-divider{height:1px;margin:8px 16px;background:#e4e4e4}
      article{width:100%;max-width:760px;margin:0 auto;padding:22px 0 40px;background:#fff}
      .amp-bc-wrap{margin:0 20px 14px}
      .amp-bc-link{display:inline-block;padding:0 0 5px;border-bottom:3px solid var(--vistazo-red);border-radius:0;background:transparent;color:var(--vistazo-red);font-size:13px;font-weight:800;letter-spacing:.04em;text-decoration:none;text-transform:uppercase}
      .amp-toptitle{margin:0 20px 8px;color:var(--vistazo-red);font-size:17px;font-weight:700;line-height:1.35;text-align:left}
      h1.amp-title{margin:0 20px 16px;color:#101010;font-family:'Crete Round',Georgia,serif;font-size:34px;font-weight:700;letter-spacing:-.02em;line-height:1.08}
      .amp-leadin{margin:0 20px 18px}
      .amp-leadin p{margin:0;color:#444;font-family:Georgia,'Times New Roman',serif;font-size:19px;line-height:1.45}
      .hero{position:relative;margin:20px 0 12px;overflow:hidden;border-radius:0;background:#eee}
      .live-pill{position:absolute;top:10px;left:10px;padding:6px 10px;font-size:12px;font-weight:700;color:#fff;background:#ff2d2d;border-radius:999px;display:flex;align-items:center;gap:6px;z-index:2}
      .live-pill .dot{width:8px;height:8px;border-radius:50%;background:#fff}
      figure{margin:0}
      figure amp-img{width:100%;height:auto}
      figure.hero figcaption,figure figcaption{position:static;padding:8px 20px 0;background:transparent;color:#777;font-size:12px;line-height:1.45}
      .meta-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:18px 20px 12px;color:#666;font-size:13px}
      .amp-author{color:#222;font-weight:700}
      .meta-dot{width:4px;height:4px;border-radius:50%;background:var(--vistazo-red)}
      .share-row{display:flex;gap:10px;margin:8px 20px 22px;padding-bottom:18px;border-bottom:1px solid var(--vistazo-border)}
      .share-row amp-social-share{width:40px;height:40px;border:1px solid #e0e0e0;border-radius:50%;background-color:#fff;background-repeat:no-repeat;background-position:center;background-size:18px 18px}
      .share-row amp-social-share:hover,.share-row amp-social-share:focus{border-color:#111;background-color:#f6f6f6}
      .share-row amp-social-share[type="facebook"]{background-image:url('data:image/svg+xml;utf8,<svg%20xmlns="http://www.w3.org/2000/svg"%20viewBox="0%200%2024%2024"%20fill="%23111"><path%20d="M18%202h-3a5%205%200%2000-5%205v3H7v4h3v8h4v-8h3l1-4h-4V7a1%201%200%20011-1h3z"/></svg>')}
      .share-row amp-social-share[type="twitter"]{background-color:#fff;background-image:url('data:image/svg+xml;utf8,<svg%20xmlns="http://www.w3.org/2000/svg"%20viewBox="0%200%2024%2024"%20fill="%23111"><path%20d="M18.244%202.25h3.308l-7.227%208.26%208.502%2011.24H16.17l-5.214-6.817L4.99%2021.75H1.68l7.73-8.835L1.254%202.25H8.08l4.713%206.231zm-1.161%2017.52h1.833L7.084%204.126H5.117z"/></svg>')}
      .share-row amp-social-share[type="whatsapp"]{background-image:url('data:image/svg+xml;utf8,<svg%20xmlns="http://www.w3.org/2000/svg"%20viewBox="0%200%2024%2024"%20fill="%23111"><path%20d="M12%202a10%2010%200%2000-8.66%2015L2%2022l5.12-1.34A10%2010%200%201012%202zm0%2018.01a8.01%208.01%200%2001-4.08-1.12l-.29-.17-3.04.8.81-2.97-.19-.3A8.01%208.01%200%201112%2020.01z"/><path%20d="M17.47%2014.38c-.3-.15-1.76-.87-2.03-.97s-.47-.15-.67.15-.77.97-.94%201.16-.35.22-.64.08-1.26-.46-2.39-1.48c-.88-.79-1.48-1.76-1.65-2.06s-.02-.46.13-.61c.13-.13.3-.35.45-.52s.2-.3.3-.5.05-.37-.03-.52-.67-1.61-.92-2.21c-.24-.58-.49-.5-.67-.51h-.57c-.2%200-.52.07-.79.37s-1.04%201.02-1.04%202.48%201.07%202.87%201.21%203.07%202.1%203.2%205.08%204.49c.71.3%201.26.49%201.69.62.71.23%201.36.2%201.87.12.57-.08%201.76-.72%202.01-1.41s.25-1.29.17-1.41-.27-.2-.57-.35z"/></svg>')}
      .share-row amp-social-share[type="email"]{background-image:url('data:image/svg+xml;utf8,<svg%20xmlns="http://www.w3.org/2000/svg"%20viewBox="0%200%2024%2024"%20fill="%23111"><path%20d="M20%204H4a2%202%200%2000-2%202v12a2%202%200%20002%202h16a2%202%200%20002-2V6a2%202%200%2000-2-2zm0%204l-8%205-8-5V6l8%205%208-5v2z"/></svg>')}
      .amp-art-body{padding:0 20px;line-height:1.5rem;color:#000}
      .paragraph p,.paragraph .h2{margin:0 0 22px;color:#252525;font-family:Georgia,'Times New Roman',serif;font-size:19px;line-height:1.72}
      .paragraph.h2 p,.paragraph p.h2{margin-top:34px;color:#111;font-family:Arial,Helvetica,sans-serif;font-size:25px;font-weight:800;line-height:1.25}
      .paragraph a{color:#b81218;font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
      .paragraph blockquote{margin:28px 0;padding:4px 0 4px 20px;border-left:4px solid var(--vistazo-red);color:#333;font-family:Georgia,serif;font-size:21px;font-style:italic;line-height:1.55}
      .ladillo{background:#f7f7f7;border-left:4px solid #bc2111;padding:10px 12px;margin:14px 0}
      .destacado{background:#edecec;border-top:3px solid #bc2111;margin:8px 0;padding:10px}
      .inline-related{margin:28px 0;padding:18px 0;border-top:4px solid var(--vistazo-red);border-bottom:1px solid var(--vistazo-border)}
      .inline-related-label{display:block;margin-bottom:8px;color:var(--vistazo-red);font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
      .inline-related a{color:#111;font-family:Arial,Helvetica,sans-serif;font-size:18px;font-weight:800;line-height:1.35;text-decoration:none}
      .amp-related{margin:40px 20px 0;padding-top:18px;border-top:5px solid var(--vistazo-red)}
      .amp-related>.amp-related-tit{margin-bottom:12px;color:#111;font-size:22px;font-weight:800}
      .amp-related ul{margin:0;padding:0;list-style:none}
      .amp-related li{margin:0;border-bottom:1px solid var(--vistazo-border)}
      .amp-related li a{display:block;padding:15px 0;color:#151515;font-size:17px;font-weight:700;line-height:1.35;text-decoration:none}
      /* LIVE BLOG (R_LIVE_BLOG_POST) - portado de rediseno/ampliada/detalle.css.
         Sin !important (AMP lo prohibe en amp-custom) y sin el prefijo .ly-lbp,
         que en AMP no existe. */
      .R_LIVE_BLOG_POST{position:relative;margin:24px 0 8px;padding:0 20px 0 32px;background:#fff}
      .r_item_post{position:relative;margin-left:10px;padding-left:20px}
      .r_item_line{position:absolute;top:0;left:0;height:100%}
      .r_point_post{position:absolute;top:0;left:-22px;width:24px;height:24px;background:url('https://codigomarret.online/upload/img/puntorojo1321320192.svg') no-repeat center/contain}
      .r_vertical-line{position:absolute;top:8px;bottom:0;left:-11px;width:2px;height:calc(100% + 20px);background:#CC1114}
      .R_LIVE_BLOG_POST .r_item_post:last-of-type .r_vertical-line{opacity:0}
      .r_item_content{margin-left:15px;padding-top:0}
      .r_date_post{display:flex;align-items:center;gap:4px;margin-bottom:10px;font-size:13px}
      .r_date_post .r_hora_post{padding:4px 8px;border-radius:4px;background:#CC1114;color:#fff}
      .r_date_post .r_fecha_post{padding:4px 8px;border-radius:4px;background:#F3F5F8}
      .r_content_post{margin-top:6px}
      .r_headline_post{margin-top:20px;color:#111;font-size:24px;font-weight:700;line-height:1.25}
      .r_text_post p{margin-top:18px;color:#252525;font-size:17px;line-height:1.6}
      .R_LIVE_BLOG_POST p a{color:#CC1114;font-weight:700;text-decoration:none}
      .r_image_post{width:100%;margin:14px 0;overflow:hidden}
      .r_image_post amp-img{width:100%;height:auto}
      .r_multimedia_post,.r_youtube_post{margin:14px 0}
      .r_cita_post{margin:16px 0;padding:4px 0 4px 16px;border-left:4px solid #CC1114;color:#333;font-family:Georgia,serif;font-size:18px;font-style:italic;line-height:1.5}
      .r_bullet_post span{position:relative;display:block;margin-bottom:8px;padding-left:16px;font-size:16px;line-height:1.55}
      .r_bullet_post span::before{position:absolute;top:8px;left:0;width:8px;height:8px;border-radius:50%;background:#CC1114;content:""}
      .r_linea_hr{border:0;border-top:1px solid #ccc;box-shadow:0 2px 5px rgba(0,0,0,.1)}
      .r_html_post{margin:14px 0}
      .r_social-icons{display:none}
      .ad-container{display:flex;min-height:120px;margin:20px auto;align-items:center;justify-content:center;overflow:hidden;background:#fafafa}
      @media (min-width:768px){body{padding:24px 0}article{border:1px solid #ececec}h1.amp-title{font-size:46px}.amp-leadin p{font-size:21px}.amp-art-body{padding-right:48px;padding-left:48px}.amp-bc-wrap,h1.amp-title,.amp-toptitle,.amp-leadin,.meta-row,.share-row{margin-right:48px;margin-left:48px}}
    </style>

    <!-- Componentes AMP que usas -->
    <script async custom-element="amp-accordion" src="https://cdn.ampproject.org/v0/amp-accordion-0.1.js"></script>
    <script async custom-element="amp-carousel" src="https://cdn.ampproject.org/v0/amp-carousel-0.1.js"></script>
    <script async custom-element="amp-social-share" src="https://cdn.ampproject.org/v0/amp-social-share-0.1.js"></script>
    <script async custom-element="amp-iframe" src="https://cdn.ampproject.org/v0/amp-iframe-0.1.js"></script>
    <script async custom-element="amp-youtube" src="https://cdn.ampproject.org/v0/amp-youtube-0.1.js"></script>
    <script async custom-element="amp-vimeo" src="https://cdn.ampproject.org/v0/amp-vimeo-0.1.js"></script>
    <script async custom-element="amp-image-lightbox" src="https://cdn.ampproject.org/v0/amp-image-lightbox-0.1.js"></script>
    <script async custom-element="amp-ad" src="https://cdn.ampproject.org/v0/amp-ad-0.1.js"></script>
    <script async custom-element="amp-analytics" src="https://cdn.ampproject.org/v0/amp-analytics-0.1.js"></script>
    <script async custom-element="amp-sticky-ad" src="https://cdn.ampproject.org/v0/amp-sticky-ad-1.0.js"></script>
    <script async custom-element="amp-video" src="https://cdn.ampproject.org/v0/amp-video-0.1.js"></script>
    <script async custom-element="amp-audio" src="https://cdn.ampproject.org/v0/amp-audio-0.1.js"></script>
    <script async custom-element="amp-brid-player" src="https://cdn.ampproject.org/v0/amp-brid-player-0.1.js"></script>

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@type":"NewsArticle",
        "headline":"$!escapeTool.html($!articleToolbox.getTag(null,'Headline').data)",
        "datePublished":"$!reserved-article-modified-date.getData()",
        "dateModified":"$!reserved-article-modified-date.getData()",
        "mainEntityOfPage":"$!articleToolbox.getArticleViewer('canonical')",
        "url":"$!articleToolbox.getArticleViewer('canonical')",
        "author":{"@type":"Person","name":"$!escapeTool.html($autor)"},
        "description":"$!escapeTool.html($!articleToolbox.getTag(null,'Subheadline').data)",
        "publisher":{
          "@type":"Organization",
          "name":"Editorial Vistazo",
          "logo":{"@type":"ImageObject","url":"$!iterVelocityTools.getVariable('0','logo_AMP')","width":200,"height":68}
        },
        "image":{"@type":"ImageObject","url":"$ogimage","width":"400","height":"225"}
      }
    </script>
  </head>
  <body>
    <main class="amp-content">
      <header class="simp-head">
        <div class="title"><a href="https://www.vistazo.com/"><div class="logo_cab"><span class="logo-text" style="display:none">Vistazo</span></div></a></div>
        <div class="hamburger_wrapper">
          <div id="hamburger" tabindex="1" role="button" on="tap:hamburger.toggleClass(class='close'),nav-menu.toggleClass(class='now-active')">
            <span></span><span></span><span></span>
          </div>
        </div>
        <nav id="nav-menu" aria-label="Menú principal">
          <div class="nav-inner">
            <div class="nav-accent"></div>
            <ul class="nav-list">
              <li><a class="nav-link" href="https://www.vistazo.com/ultimasnoticias">Últimas Noticias</a></li>
              <li><a class="nav-link" href="/actualidad">Actualidad</a></li>
              <li><a class="nav-link" href="/politica">Política</a></li>
              <li><a class="nav-link" href="/seguridad">Seguridad</a></li>
              <li><a class="nav-link" href="/mundo">Mundo</a></li>
              <li><a class="nav-link" href="/opinion">Opinión</a></li>
            </ul>

            <amp-accordion class="nav-accordion" animate disable-session-states>
              <section>
                <header>
                  <a class="nav-parent-link" href="/tendencias">Tendencias</a>
                  <span class="nav-arrow" aria-hidden="true"></span>
                </header>
                <div class="nav-submenu">
                  <a href="/tendencias/bienestar">Bienestar</a>
                  <a href="/tendencias/tecnologia">Tecnología</a>
                  <a href="/tendencias/mascotas">Mascotas</a>
